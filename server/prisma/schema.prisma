generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 1. Customer
// ---------------------------------------------------------------------------
model Customer {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings   Booking[]
  reviews    Review[]
  warranties Warranty[]
}

// ---------------------------------------------------------------------------
// 2. HqAdmin
// ---------------------------------------------------------------------------
model HqAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  activatedMerchants Merchant[]       @relation("ActivatedBy")
  commissionRules    CommissionRule[]
  approvedClaims     WarrantyClaim[]  @relation("ApprovedBy")
}

// ---------------------------------------------------------------------------
// 3. Merchant
// ---------------------------------------------------------------------------
model Merchant {
  id            String    @id @default(uuid())
  slug          String    @unique
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  address       String?
  city          String?
  county        String?
  eircode       String?
  latitude      Float?
  longitude     Float?
  logoUrl       String?
  coverPhotoUrl String?
  description   String?
  ratingAvg     Decimal   @default(0) @db.Decimal(3, 2)
  ratingCount   Int       @default(0)
  status        String    @default("pending")
  activatedAt   DateTime?
  activatedById String?
  activatedBy   HqAdmin?  @relation("ActivatedBy", fields: [activatedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  photos        MerchantPhoto[]
  businessHours MerchantBusinessHour[]
  bookingSlot   MerchantBookingSlot?
  products      MerchantProduct[]
  bookings      Booking[]
  reviews       Review[]
  commissions   CommissionLedger[]
  warrantiesOriginal Warranty[]      @relation("OriginalMerchant")
  claimsAsClaimant   WarrantyClaim[] @relation("ClaimingMerchant")
  claimsAsOriginal   WarrantyClaim[] @relation("OriginalMerchantClaim")
}

// ---------------------------------------------------------------------------
// 4. MerchantPhoto
// ---------------------------------------------------------------------------
model MerchantPhoto {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 5. MerchantBusinessHour
// ---------------------------------------------------------------------------
model MerchantBusinessHour {
  id         String   @id @default(uuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  dayOfWeek  Int      // 0 = Sunday, 6 = Saturday
  openTime   String?  // e.g. "09:00"
  closeTime  String?  // e.g. "17:30"
  isClosed   Boolean  @default(false)

  @@unique([merchantId, dayOfWeek])
}

// ---------------------------------------------------------------------------
// 6. MerchantBookingSlot
// ---------------------------------------------------------------------------
model MerchantBookingSlot {
  id            String   @id @default(uuid())
  merchantId    String   @unique
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  slotDuration  Int      @default(30)
  maxConcurrent Int      @default(3)
  bufferMinutes Int      @default(0)
  advanceDays   Int      @default(14)
}

// ---------------------------------------------------------------------------
// 7. MasterCategory
// ---------------------------------------------------------------------------
model MasterCategory {
  id        String          @id @default(uuid())
  name      String
  icon      String?
  sortOrder Int             @default(0)

  products  MasterProduct[]
}

// ---------------------------------------------------------------------------
// 8. MasterBrand
// ---------------------------------------------------------------------------
model MasterBrand {
  id        String         @id @default(uuid())
  name      String
  logoUrl   String?
  sortOrder Int            @default(0)

  devices   MasterDevice[]
}

// ---------------------------------------------------------------------------
// 9. MasterDevice
// ---------------------------------------------------------------------------
model MasterDevice {
  id        String          @id @default(uuid())
  brandId   String
  brand     MasterBrand     @relation(fields: [brandId], references: [id])
  name      String
  imageUrl  String?
  sortOrder Int             @default(0)

  products  MasterProduct[]
}

// ---------------------------------------------------------------------------
// 10. MasterProduct
// ---------------------------------------------------------------------------
model MasterProduct {
  id             String   @id @default(uuid())
  deviceId       String
  device         MasterDevice    @relation(fields: [deviceId], references: [id])
  categoryId     String
  category       MasterCategory  @relation(fields: [categoryId], references: [id])
  sku            String   @unique
  name           String
  description    String?
  baseCost       Decimal  @db.Decimal(10, 2)
  suggestedPrice Decimal  @db.Decimal(10, 2)
  imageUrl       String?
  estimatedTime  Int?     // minutes
  warrantyDays   Int      @default(180)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchantProducts MerchantProduct[]
  warranties       Warranty[]
}

// ---------------------------------------------------------------------------
// 11. MerchantProduct
// ---------------------------------------------------------------------------
model MerchantProduct {
  id         String        @id @default(uuid())
  merchantId String
  merchant   Merchant      @relation(fields: [merchantId], references: [id])
  productId  String
  product    MasterProduct @relation(fields: [productId], references: [id])
  myPrice    Decimal       @db.Decimal(10, 2)
  isActive   Boolean       @default(true)
  inStock    Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  bookings   Booking[]

  @@unique([merchantId, productId])
}

// ---------------------------------------------------------------------------
// 12. Booking
// ---------------------------------------------------------------------------
model Booking {
  id                String    @id @default(uuid())
  bookingNumber     String    @unique
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  merchantId        String
  merchant          Merchant  @relation(fields: [merchantId], references: [id])
  merchantProductId String
  merchantProduct   MerchantProduct @relation(fields: [merchantProductId], references: [id])
  serviceName       String
  servicePrice      Decimal   @db.Decimal(10, 2)
  depositAmount     Decimal   @db.Decimal(10, 2)
  remainingAmount   Decimal   @db.Decimal(10, 2)
  bookingDate       DateTime  @db.Date
  bookingTime       String    // e.g. "10:30"
  estimatedDuration Int?      // minutes
  status            String    @default("confirmed")
  checkedInAt       DateTime?
  completedAt       DateTime?
  customerName      String?
  customerPhone     String?
  customerNote      String?
  qrCode            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  deposits          Deposit[]
  review            Review?
  warranty          Warranty?
  commissions       CommissionLedger[]
}

// ---------------------------------------------------------------------------
// 13. Deposit
// ---------------------------------------------------------------------------
model Deposit {
  id                String    @id @default(uuid())
  bookingId         String
  booking           Booking   @relation(fields: [bookingId], references: [id])
  amount            Decimal   @db.Decimal(10, 2)
  stripePaymentId   String?
  stripeCheckoutId  String?
  status            String    @default("paid")
  refundedAt        DateTime?
  createdAt         DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// 14. CommissionRule
// ---------------------------------------------------------------------------
model CommissionRule {
  id          String    @id @default(uuid())
  name        String
  rate        Decimal   @db.Decimal(5, 4)
  scopeType   String    // e.g. "global", "category", "merchant"
  scopeValue  String?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  createdById String
  createdBy   HqAdmin   @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  ledgerEntries CommissionLedger[]
}

// ---------------------------------------------------------------------------
// 15. CommissionLedger
// ---------------------------------------------------------------------------
model CommissionLedger {
  id               String         @id @default(uuid())
  bookingId        String
  booking          Booking        @relation(fields: [bookingId], references: [id])
  merchantId       String
  merchant         Merchant       @relation(fields: [merchantId], references: [id])
  ruleId           String
  rule             CommissionRule @relation(fields: [ruleId], references: [id])
  servicePrice     Decimal        @db.Decimal(10, 2)
  commissionRate   Decimal        @db.Decimal(5, 4)
  commissionAmount Decimal        @db.Decimal(10, 2)
  status           String         @default("pending")
  createdAt        DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// 16. Warranty
// ---------------------------------------------------------------------------
model Warranty {
  id                 String    @id @default(uuid())
  warrantyNumber     String    @unique
  bookingId          String    @unique
  booking            Booking   @relation(fields: [bookingId], references: [id])
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id])
  originalMerchantId String
  originalMerchant   Merchant  @relation("OriginalMerchant", fields: [originalMerchantId], references: [id])
  productId          String
  product            MasterProduct @relation(fields: [productId], references: [id])
  deviceName         String
  serviceName        String
  startDate          DateTime  @db.Date
  endDate            DateTime  @db.Date
  status             String    @default("active")
  createdAt          DateTime  @default(now())

  claims             WarrantyClaim[]
}

// ---------------------------------------------------------------------------
// 17. WarrantyClaim
// ---------------------------------------------------------------------------
model WarrantyClaim {
  id                  String    @id @default(uuid())
  warrantyId          String
  warranty            Warranty  @relation(fields: [warrantyId], references: [id])
  claimingMerchantId  String
  claimingMerchant    Merchant  @relation("ClaimingMerchant", fields: [claimingMerchantId], references: [id])
  originalMerchantId  String
  originalMerchant    Merchant  @relation("OriginalMerchantClaim", fields: [originalMerchantId], references: [id])
  partCost            Decimal   @db.Decimal(10, 2)
  laborSubsidy        Decimal   @default(30) @db.Decimal(10, 2)
  totalCompensation   Decimal   @db.Decimal(10, 2)
  status              String    @default("pending")
  approvedById        String?
  approvedBy          HqAdmin?  @relation("ApprovedBy", fields: [approvedById], references: [id])
  settledAt           DateTime?
  customerNote        String?
  merchantNote        String?
  createdAt           DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// 18. Review
// ---------------------------------------------------------------------------
model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}
