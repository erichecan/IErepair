generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DeviceCategory {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  nameEn      String        @unique
  slug        String        @unique
  sortOrder   Int           @default(0)
  brands      DeviceBrand[]
  repairTypes RepairType[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DeviceBrand {
  id         Int            @id @default(autoincrement())
  name       String
  slug       String
  categoryId Int
  category   DeviceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int            @default(0)
  models     DeviceModel[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([categoryId, slug])
}

model DeviceModel {
  id             Int             @id @default(autoincrement())
  name           String
  brandId        Int
  brand          DeviceBrand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  year           Int?
  isActive       Boolean         @default(true)
  repairServices RepairService[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([brandId, name])
}

model RepairType {
  id             Int             @id @default(autoincrement())
  name           String
  nameEn         String
  categoryId     Int
  category       DeviceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder      Int             @default(0)
  repairServices RepairService[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([categoryId, nameEn])
}

model RepairService {
  id              Int               @id @default(autoincrement())
  deviceModelId   Int
  deviceModel     DeviceModel       @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)
  repairTypeId    Int
  repairType      RepairType        @relation(fields: [repairTypeId], references: [id], onDelete: Cascade)
  basePriceMin    Decimal           @db.Decimal(10, 2)
  basePriceMax    Decimal           @db.Decimal(10, 2)
  durationMinutes Int               @default(60)
  isActive         Boolean           @default(true)
  merchantServices MerchantService[]
  repairBookings   RepairBooking[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([deviceModelId, repairTypeId])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Merchant {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  passwordHash       String
  phone              String?
  address            String?
  eircode            String?
  description        String?
  images             String[]
  lat                Float?
  lng                Float?
  isActive           Boolean           @default(true)
  mustChangePassword Boolean           @default(true)
  merchantProducts   MerchantProduct[]
  merchantServices   MerchantService[]
  merchantHours      MerchantHours[]
  repairBookings     RepairBooking[]
  reviews            MerchantReview[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ProductCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  nameEn    String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               Int               @id @default(autoincrement())
  name             String
  nameEn           String?
  description      String?
  brand            String?
  categoryId       Int
  category         ProductCategory   @relation(fields: [categoryId], references: [id])
  images           String[]
  basePriceMin     Decimal?          @db.Decimal(10, 2)
  basePriceMax     Decimal?          @db.Decimal(10, 2)
  isActive         Boolean           @default(true)
  status           String            @default("active")
  notes            String?
  merchantProducts MerchantProduct[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model MerchantProduct {
  id         Int      @id @default(autoincrement())
  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([merchantId, productId])
  @@index([merchantId])
  @@index([productId])
}

model MerchantService {
  id              Int           @id @default(autoincrement())
  merchantId      Int
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  repairServiceId Int
  repairService   RepairService @relation(fields: [repairServiceId], references: [id], onDelete: Cascade)
  price           Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([merchantId, repairServiceId])
  @@index([merchantId])
  @@index([repairServiceId])
}

model MerchantHours {
  id         Int      @id @default(autoincrement())
  merchantId Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  isClosed   Boolean  @default(false)

  @@unique([merchantId, dayOfWeek])
  @@index([merchantId])
}

model RepairBooking {
  id               Int      @id @default(autoincrement())
  orderNumber      String   @unique
  merchantId       Int
  merchant         Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  repairServiceId  Int
  repairService    RepairService @relation(fields: [repairServiceId], references: [id])
  status           String   @default("pending_confirm")
  userName         String
  userPhone        String
  userEmail        String?
  appointmentTime  DateTime
  quotedPrice      Decimal  @db.Decimal(10, 2)
  actualPrice      Decimal? @db.Decimal(10, 2)
  notes            String?
  cancelReason     String?
  review           MerchantReview?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([merchantId])
  @@index([status])
  @@index([appointmentTime])
}

model MerchantReview {
  id         Int           @id @default(autoincrement())
  merchantId Int
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  bookingId  Int           @unique
  booking    RepairBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userName   String
  rating     Int
  comment    String?
  isVisible  Boolean       @default(true)
  createdAt  DateTime      @default(now())

  @@index([merchantId])
}
